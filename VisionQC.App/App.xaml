<!-- App.xaml: 애플리케이션 정의. 코드 비하인드(App.xaml.cs)가 시작 흐름(로그인 창, 메인 창, 로그아웃 반복)을 직접 처리하므로 StartupUri는 없다.
     여기서는 앱 전체에서 쓰는 리소스, 즉 바인딩 값 변환기(IValueConverter)만 등록한다. 등록한 키는 모든 창의 XAML에서 StaticResource 로 쓸 수 있다. -->
<Application x:Class="VisionQC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VisionQC.App">
    <Application.Resources>
        <!-- InvertBool: bool 값을 뒤집는다. 예) 검사 중(IsRunning)이면 입력 모드 콤보박스를 비활성화. -->
        <local:InvertBoolConverter x:Key="InvertBool"/>
        <!-- FileName: 전체 경로를 파일 이름만으로 줄여 목록에 보여 준다. -->
        <local:FileNameConverter x:Key="FileName"/>
        <!-- LocalTime: UTC 로 저장된 시각을 사용자 PC 의 로컬 시각 글자로 바꾼다(이력 탭 시각 열). -->
        <local:LocalTimeConverter x:Key="LocalTime"/>
        <!-- BoolToVis: WPF 기본 변환기. true 는 보임(Visible), false 는 숨김(Collapsed). 입력 모드에 따라 입력칸을 보이거나 숨길 때 쓴다. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Application.Resources>
</Application>
