<Window x:Class="VisionQC.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 변경" Width="360" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="현재 비밀번호"/>
        <PasswordBox x:Name="OldBox" Margin="0,2,0,8"/>
        <TextBlock Text="새 비밀번호 (8자 이상, 아이디 포함 불가)"/>
        <PasswordBox x:Name="NewBox" Margin="0,2,0,8"/>
        <TextBlock Text="새 비밀번호 확인"/>
        <PasswordBox x:Name="ConfirmBox" Margin="0,2,0,8"/>
        <TextBlock x:Name="MessageText" Foreground="Crimson" TextWrapping="Wrap" MinHeight="18" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="변경" IsDefault="True" Padding="20,4" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Padding="14,4"/>
        </StackPanel>
    </StackPanel>
</Window>
