<Window x:Class="VisionQC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionQC - AI 외관검사" Width="1100" Height="720" MinWidth="900" MinHeight="600">
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

        <TabItem Header="검사" x:Name="InspectionTab">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                    <TextBlock Text="이미지 폴더" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Column="1" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"/>
                    <Button Grid.Column="2" Content="찾아보기" Command="{Binding BrowseFolderCommand}" Padding="10,2" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Text="모델(.onnx)" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="찾아보기" Command="{Binding BrowseModelCommand}" Padding="10,2" Margin="0,0,0,6"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <TextBlock Text="임계값" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Width="200" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Threshold}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}"/>
                        <TextBlock Text="{Binding Threshold, StringFormat=F2}" Width="40" Margin="8,0,24,0" VerticalAlignment="Center"/>
                        <Button Content="▶ 시작" Command="{Binding StartCommand}" Padding="16,4" Margin="0,0,8,0"/>
                        <Button Content="■ 중지" Command="{Binding StopCommand}" Padding="16,4"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <Border BorderBrush="LightGray" BorderThickness="1" Background="#FF1E1E1E">
                        <Image Source="{Binding CurrentImage}" Stretch="Uniform"/>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border DockPanel.Dock="Top" Background="{Binding VerdictBrush}" CornerRadius="6" Height="110">
                            <TextBlock Text="{Binding VerdictText}" Foreground="White" FontSize="56" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailText}" Margin="0,8,0,8" TextWrapping="Wrap"/>
                        <TextBlock DockPanel.Dock="Top" Text="최근 결과" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Recent}" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Verdict}" Width="52" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Score, StringFormat=F2}" Width="40"/>
                                        <TextBlock Text="{Binding ImagePath, Converter={StaticResource FileName}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="총 "/><TextBlock Text="{Binding Total}" FontWeight="Bold"/>
                        <TextBlock Text="   OK "/><TextBlock Text="{Binding Ok}" FontWeight="Bold" Foreground="SeaGreen"/>
                        <TextBlock Text="   NG "/><TextBlock Text="{Binding Ng}" FontWeight="Bold" Foreground="Crimson"/>
                        <TextBlock Text="   ERROR "/><TextBlock Text="{Binding Error}" FontWeight="Bold" Foreground="DarkOrange"/>
                        <TextBlock Text="   양품률 "/><TextBlock Text="{Binding YieldText}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="DimGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="이력" x:Name="HistoryTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                    <TextBlock Text="판정" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox ItemsSource="{Binding VerdictOptions}" SelectedItem="{Binding SelectedVerdict}" Width="90"/>
                    <Button Content="조회" Command="{Binding RefreshCommand}" Padding="16,2" Margin="16,0,12,0"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="DimGray"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding InspectedAtUtc, Converter={StaticResource LocalTime}}" Width="150"/>
                            <DataGridTextColumn Header="판정" Binding="{Binding Verdict}" Width="70"/>
                            <DataGridTextColumn Header="점수" Binding="{Binding Score, StringFormat=F3}" Width="70"/>
                            <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs}" Width="60"/>
                            <DataGridTextColumn Header="파일" Binding="{Binding ImagePath, Converter={StaticResource FileName}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedDetail}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Background="#FF1E1E1E">
                            <Image Source="{Binding SelectedImage}" Stretch="Uniform"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="재판정" x:Name="ReviewTab">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                    <TextBlock Text="판정" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox ItemsSource="{Binding VerdictOptions}" SelectedItem="{Binding SelectedVerdict}" Width="80"/>
                    <TextBlock Text="정정" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox ItemsSource="{Binding ReviewOptions}" SelectedItem="{Binding SelectedReviewFilter}" Width="90"/>
                    <Button Content="조회" Command="{Binding RefreshCommand}" Padding="16,2" Margin="16,0,12,0"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="DimGray"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#FFF4F6FA" BorderBrush="LightGray" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="재판정 임계값 (미리보기)" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Slider Width="260" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding Threshold}" AutomationProperties.AutomationId="ReviewThreshold"/>
                            <TextBlock Text="{Binding Threshold, StringFormat=F2}" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewSummary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TruthSummary}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#FF305496"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.AutomationId="ReviewGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="100"/>
                            <DataGridTextColumn Header="원 판정" Binding="{Binding OriginalText}" Width="62"/>
                            <DataGridTextColumn Header="점수" Binding="{Binding ScoreText}" Width="58"/>
                            <DataGridTextColumn Header="재판정" Binding="{Binding PreviewText}" Width="80"/>
                            <DataGridTextColumn Header="정정" Binding="{Binding CorrectedText}" Width="80"/>
                            <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="메모(선택, 500자)" Foreground="DimGray"/>
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Height="46" TextWrapping="Wrap"
                                     AcceptsReturn="False" AutomationProperties.AutomationId="ReviewNote"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="정상(OK)으로 정정" Command="{Binding CorrectToOkCommand}" Padding="12,4" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="CorrectOkButton"/>
                                <Button Content="불량(NG)으로 정정" Command="{Binding CorrectToNgCommand}" Padding="12,4"
                                        AutomationProperties.AutomationId="CorrectNgButton"/>
                            </StackPanel>
                            <TextBlock Text="정정 이력(오래된 순, 가장 나중 정정이 유효)" Foreground="DimGray" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" MaxHeight="70"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedDetail}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Background="#FF1E1E1E">
                            <Image Source="{Binding SelectedImage}" Stretch="Uniform"/>
                        </Border>
                    </DockPanel>
                </Grid>

                <TextBlock Grid.Row="3" Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap"
                           Text="정정은 원 판정을 덮어쓰지 않고 기록으로 쌓입니다. 현재는 로그인이 없어 Windows 사용자 이름이 정정자로 기록되며 권한 구분은 없습니다."/>
            </Grid>
        </TabItem>

        <TabItem Header="통계" x:Name="StatsTab">
            <TabItem.Resources>
                <DataTemplate x:Key="BarRow">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="14" Margin="4,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
                <Style x:Key="CardValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="26"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </TabItem.Resources>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                    <Button Content="조회" Command="{Binding RefreshCommand}" Padding="16,2" Margin="16,0,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="총 검사"/><TextBlock Text="{Binding TotalText}" Style="{StaticResource CardValue}"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="OK"/><TextBlock Text="{Binding OkText}" Style="{StaticResource CardValue}" Foreground="SeaGreen"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="NG"/><TextBlock Text="{Binding NgText}" Style="{StaticResource CardValue}" Foreground="Crimson"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="ERROR"/><TextBlock Text="{Binding ErrorText}" Style="{StaticResource CardValue}" Foreground="DarkOrange"/></StackPanel>
                    <StackPanel><TextBlock Text="양품률 (OK÷(OK+NG))"/><TextBlock Text="{Binding YieldText}" Style="{StaticResource CardValue}"/></StackPanel>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="일별 양품률" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Daily}" ItemTemplate="{StaticResource BarRow}"/>
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="불량 유형 분포" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DefectTypes}" ItemTemplate="{StaticResource BarRow}"/>
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="처리시간 분포" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TimeHistogram}" ItemTemplate="{StaticResource BarRow}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding TimeText}"/>
                    <TextBlock Text="{Binding Message}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
