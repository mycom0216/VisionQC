<Window x:Class="VisionQC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionQC.App"
        Title="VisionQC - AI 외관검사" Width="1100" Height="720" MinWidth="900" MinHeight="600">
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="12,6,12,2" LastChildFill="False">
        <TextBlock x:Name="UserLabel" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="UserLabel"/>
        <Button Content="로그아웃" DockPanel.Dock="Right" Padding="12,2" Click="Logout_Click" AutomationProperties.AutomationId="LogoutButton"/>
        <Button Content="비밀번호 변경" DockPanel.Dock="Right" Padding="12,2" Margin="0,0,8,0" Click="ChangePassword_Click"/>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

        <TabItem Header="검사" x:Name="InspectionTab">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                    <TextBlock Text="이미지 폴더" VerticalAlignment="Center" Margin="0,0,8,6" Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Column="1" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                             Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="2" Content="찾아보기" Command="{Binding BrowseFolderCommand}" Padding="10,2" Margin="0,0,0,6"
                            Visibility="{Binding IsFolderMode, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="카메라 번호 / 영상 파일" VerticalAlignment="Center" Margin="0,0,8,6" Visibility="{Binding IsCameraMode, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Grid.Column="1" Text="{Binding CameraSpec, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                             ToolTip="0, 1 … = 카메라 번호, 그 외는 영상 파일 경로(영상은 끝나면 자동 종료)"
                             Visibility="{Binding IsCameraMode, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="CameraSpec"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding IsCameraMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="간격(초)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding CaptureIntervalText, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.AutomationId="CaptureInterval"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SettingsSummary}" Foreground="DimGray"
                               Margin="0,0,0,6" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsSummary"/>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Button Content="▶ 시작" Command="{Binding StartCommand}" Padding="16,4" Margin="0,0,8,0" AutomationProperties.AutomationId="StartButton"/>
                        <Button Content="■ 중지" Command="{Binding StopCommand}" Padding="16,4" Margin="0,0,16,0" AutomationProperties.AutomationId="StopButton"/>
                        <CheckBox Content="불량 위치 히트맵(참고용)" VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="{Binding Source={x:Static local:ViewOptions.Instance}, Path=ShowHeatmap}"
                                  ToolTip="붉을수록 불량 판정에 기여한 영역입니다. 7×7 격자를 확대한 대략적인 위치이며 정확한 윤곽이 아닙니다. NG 결과에만 표시됩니다."
                                  AutomationProperties.AutomationId="ShowHeatmap"/>
                        <TextBlock Text="입력" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding ModeOptions}" SelectedIndex="{Binding ModeIndex}" Width="260" VerticalAlignment="Center"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}" AutomationProperties.AutomationId="InputMode"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <Border BorderBrush="LightGray" BorderThickness="1" Background="#FF1E1E1E">
                        <Image Source="{Binding CurrentImage}" Stretch="Uniform"/>
                    </Border>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border DockPanel.Dock="Top" Background="{Binding VerdictBrush}" CornerRadius="6" Height="110">
                            <TextBlock Text="{Binding VerdictText}" Foreground="White" FontSize="56" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailText}" Margin="0,8,0,8" TextWrapping="Wrap"/>
                        <TextBlock DockPanel.Dock="Top" Text="최근 결과" FontWeight="SemiBold"/>
                        <ListBox ItemsSource="{Binding Recent}" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Verdict}" Width="52" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Score, StringFormat=F2}" Width="40"/>
                                        <TextBlock Text="{Binding ImagePath, Converter={StaticResource FileName}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="총 "/><TextBlock Text="{Binding Total}" FontWeight="Bold"/>
                        <TextBlock Text="   OK "/><TextBlock Text="{Binding Ok}" FontWeight="Bold" Foreground="SeaGreen"/>
                        <TextBlock Text="   NG "/><TextBlock Text="{Binding Ng}" FontWeight="Bold" Foreground="Crimson"/>
                        <TextBlock Text="   ERROR "/><TextBlock Text="{Binding Error}" FontWeight="Bold" Foreground="DarkOrange"/>
                        <TextBlock Text="   양품률 "/><TextBlock Text="{Binding YieldText}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="DimGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="이력" x:Name="HistoryTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                    <TextBlock Text="판정" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox ItemsSource="{Binding VerdictOptions}" SelectedItem="{Binding SelectedVerdict}" Width="90"/>
                    <Button Content="조회" Command="{Binding RefreshCommand}" Padding="16,2" Margin="16,0,12,0"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="DimGray"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding InspectedAtUtc, Converter={StaticResource LocalTime}}" Width="150"/>
                            <DataGridTextColumn Header="판정" Binding="{Binding Verdict}" Width="70"/>
                            <DataGridTextColumn Header="점수" Binding="{Binding Score, StringFormat=F3}" Width="70"/>
                            <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs}" Width="60"/>
                            <DataGridTextColumn Header="파일" Binding="{Binding ImagePath, Converter={StaticResource FileName}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <CheckBox DockPanel.Dock="Bottom" Content="불량 위치 히트맵(NG, 참고용)" Margin="0,6,0,0"
                                  IsChecked="{Binding Source={x:Static local:ViewOptions.Instance}, Path=ShowHeatmap}"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedDetail}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Background="#FF1E1E1E">
                            <Image Source="{Binding SelectedImage}" Stretch="Uniform"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="재판정" x:Name="ReviewTab">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                    <TextBlock Text="판정" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox ItemsSource="{Binding VerdictOptions}" SelectedItem="{Binding SelectedVerdict}" Width="80"/>
                    <TextBlock Text="정정" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox ItemsSource="{Binding ReviewOptions}" SelectedItem="{Binding SelectedReviewFilter}" Width="90"/>
                    <Button Content="조회" Command="{Binding RefreshCommand}" Padding="16,2" Margin="16,0,12,0"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="DimGray"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#FFF4F6FA" BorderBrush="LightGray" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="재판정 임계값 (미리보기)" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Slider Width="260" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding Threshold}" AutomationProperties.AutomationId="ReviewThreshold"/>
                            <TextBlock Text="{Binding Threshold, StringFormat=F2}" Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewSummary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TruthSummary}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#FF305496"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.AutomationId="ReviewGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="100"/>
                            <DataGridTextColumn Header="원 판정" Binding="{Binding OriginalText}" Width="62"/>
                            <DataGridTextColumn Header="점수" Binding="{Binding ScoreText}" Width="58"/>
                            <DataGridTextColumn Header="재판정" Binding="{Binding PreviewText}" Width="80"/>
                            <DataGridTextColumn Header="정정" Binding="{Binding CorrectedText}" Width="80"/>
                            <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="메모(선택, 500자)" Foreground="DimGray"/>
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Height="46" TextWrapping="Wrap"
                                     AcceptsReturn="False" AutomationProperties.AutomationId="ReviewNote"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="정상(OK)으로 정정" Command="{Binding CorrectToOkCommand}" Padding="12,4" Margin="0,0,8,0"
                                        AutomationProperties.AutomationId="CorrectOkButton"/>
                                <Button Content="불량(NG)으로 정정" Command="{Binding CorrectToNgCommand}" Padding="12,4"
                                        AutomationProperties.AutomationId="CorrectNgButton"/>
                            </StackPanel>
                            <TextBlock Text="정정 이력(오래된 순, 가장 나중 정정이 유효)" Foreground="DimGray" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" MaxHeight="70"/>
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Bottom" Content="불량 위치 히트맵(NG, 참고용)" Margin="0,6,0,0"
                                  IsChecked="{Binding Source={x:Static local:ViewOptions.Instance}, Path=ShowHeatmap}"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedDetail}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Background="#FF1E1E1E">
                            <Image Source="{Binding SelectedImage}" Stretch="Uniform"/>
                        </Border>
                    </DockPanel>
                </Grid>

                <TextBlock Grid.Row="3" Margin="0,6,0,0" Foreground="DimGray" TextWrapping="Wrap"
                           Text="정정은 원 판정을 덮어쓰지 않고 기록으로 쌓입니다. 정정자는 로그인한 계정으로 기록되고 모든 정정은 감사 로그에 남습니다(엔지니어 이상만 가능)."/>
            </Grid>
        </TabItem>

        <TabItem Header="통계" x:Name="StatsTab">
            <TabItem.Resources>
                <DataTemplate x:Key="BarRow">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="14" Margin="4,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
                <Style x:Key="CardValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="26"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </TabItem.Resources>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="120"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="120"/>
                    <Button Content="조회" Command="{Binding RefreshCommand}" Padding="16,2" Margin="16,0,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="총 검사"/><TextBlock Text="{Binding TotalText}" Style="{StaticResource CardValue}"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="OK"/><TextBlock Text="{Binding OkText}" Style="{StaticResource CardValue}" Foreground="SeaGreen"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="NG"/><TextBlock Text="{Binding NgText}" Style="{StaticResource CardValue}" Foreground="Crimson"/></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Text="ERROR"/><TextBlock Text="{Binding ErrorText}" Style="{StaticResource CardValue}" Foreground="DarkOrange"/></StackPanel>
                    <StackPanel><TextBlock Text="양품률 (OK÷(OK+NG))"/><TextBlock Text="{Binding YieldText}" Style="{StaticResource CardValue}"/></StackPanel>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="일별 양품률" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Daily}" ItemTemplate="{StaticResource BarRow}"/>
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="불량 유형 분포" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DefectTypes}" ItemTemplate="{StaticResource BarRow}"/>
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="처리시간 분포" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TimeHistogram}" ItemTemplate="{StaticResource BarRow}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding TimeText}"/>
                    <TextBlock Text="{Binding Message}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="설정" x:Name="SettingsTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="검사 설정 (엔지니어 이상 변경 가능)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="모델(.onnx)"/>
                <DockPanel Margin="0,2,0,10">
                    <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseModelCommand}" Padding="10,2" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SettingsModelPath"/>
                </DockPanel>

                <TextBlock Text="임계값 (불량 점수 ≥ 임계값이면 NG)"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <Slider Width="300" Minimum="0" Maximum="1" Value="{Binding Threshold}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=LostFocus}" Width="70" Margin="10,0,0,0"
                             AutomationProperties.AutomationId="SettingsThreshold"/>
                </StackPanel>

                <CheckBox Content="관심 영역(ROI) 사용 — 학습 때와 같은 영역으로 학습한 모델이어야 함" IsChecked="{Binding UseRoi}"
                          AutomationProperties.AutomationId="SettingsUseRoi" Margin="0,4,0,4"/>
                <Grid IsEnabled="{Binding UseRoi}" Margin="16,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="300"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="왼쪽 X (%)"/><Slider Grid.Column="1" Minimum="0" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RoiX}"/><TextBlock Grid.Column="2" Text="{Binding RoiX}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="1" Text="위쪽 Y (%)"/><Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RoiY}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RoiY}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="2" Text="폭 W (%)"/><Slider Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RoiW}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RoiW}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="3" Text="높이 H (%)"/><Slider Grid.Row="3" Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RoiH}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RoiH}" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="자동 로그아웃 (무조작 시간, 분 · 검사/감시 중에는 적용 안 됨)"/>
                <TextBox Text="{Binding IdleMinutesText, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Margin="0,2,0,14"
                         AutomationProperties.AutomationId="SettingsIdleMinutes"/>

                <TextBlock Text="자동 백업 주기 (시간, 0=끔 · 앱이 켜져 있고 로그인돼 있을 때만 동작)"/>
                <TextBox Text="{Binding AutoBackupHoursText, UpdateSourceTrigger=LostFocus}" Width="70" HorizontalAlignment="Left" Margin="0,2,0,14"
                         AutomationProperties.AutomationId="SettingsAutoBackup"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="저장" Command="{Binding SaveCommand}" Padding="22,4" Margin="0,0,8,0" AutomationProperties.AutomationId="SettingsSave"/>
                    <Button Content="되돌리기" Command="{Binding RevertCommand}" Padding="16,4"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsMessage"/>
                <TextBlock Text="{Binding FileInfo}" Margin="0,10,0,0" Foreground="DimGray" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="데이터" x:Name="DataTab">
            <Grid Margin="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <TextBlock Text="백업에서 복원" FontSize="15" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.AutomationId="BackupList">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="백업 파일" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="만든 시각" Binding="{Binding StampText}" Width="150"/>
                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Button Content="선택한 백업으로 복원…" Padding="12,4" HorizontalAlignment="Left" Click="Restore_Click" AutomationProperties.AutomationId="RestoreButton"/>
                        <TextBlock TextWrapping="Wrap" Foreground="DimGray" Margin="0,8,0,0"
                                   Text="복원하면 현재 DB는 prerestore_visionqc_*.db로 먼저 보관되고, 앱이 로그인 화면으로 돌아갑니다. 백업 이후의 이력·계정 변경은 되돌려집니다."/>
                        <Button Content="목록 새로고침" Command="{Binding RefreshCommand}" Padding="10,2" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="오래된 이력 정리 (되돌릴 수 없음 — 삭제 직전에 자동으로 백업)" FontSize="15" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="보관 일수(최소 30)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding PurgeDaysText, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.AutomationId="PurgeDays"/>
                        <Button Content="대상 건수 미리보기" Padding="12,3" Margin="12,0,0,0" Click="PurgePreview_Click" AutomationProperties.AutomationId="PurgePreviewButton"/>
                        <Button Content="삭제…" Padding="16,3" Margin="8,0,0,0" Click="Purge_Click" AutomationProperties.AutomationId="PurgeButton"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PurgePreview}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PurgePreview"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="DataMessage"/>
            </Grid>
        </TabItem>

        <TabItem Header="관리" x:Name="AdminTab">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <TextBlock Text="사용자" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" AutomationProperties.AutomationId="UserGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="아이디" Binding="{Binding LoginId}" Width="*"/>
                            <DataGridTextColumn Header="역할" Binding="{Binding RoleText}" Width="90"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding StateText}" Width="70"/>
                            <DataGridTextColumn Header="생성" Binding="{Binding CreatedText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="새 사용자" Foreground="DimGray"/>
                        <TextBox x:Name="NewLoginId" AutomationProperties.AutomationId="NewLoginId" Margin="0,2,0,4"/>
                        <PasswordBox x:Name="NewPassword" AutomationProperties.AutomationId="NewPassword" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="NewRole" Width="110" SelectedIndex="0" AutomationProperties.AutomationId="NewRole">
                                <ComboBoxItem Content="Operator"/><ComboBoxItem Content="Engineer"/><ComboBoxItem Content="Admin"/>
                            </ComboBox>
                            <Button Content="만들기" Padding="14,2" Margin="8,0,0,0" Click="CreateUser_Click" AutomationProperties.AutomationId="CreateUserButton"/>
                        </StackPanel>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="선택한 사용자" Foreground="DimGray"/>
                        <Button Content="활성/비활성 전환" Padding="10,2" Margin="0,4,0,6" HorizontalAlignment="Left" Click="ToggleActive_Click"/>
                        <PasswordBox x:Name="ResetPassword" Margin="0,0,0,4"/>
                        <Button Content="비밀번호 재설정(잠금 해제 포함)" Padding="10,2" HorizontalAlignment="Left" Click="ResetPassword_Click"/>
                        <TextBlock Text="{Binding UserMessage}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="UserMessage"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,4">
                    <TextBlock Text="감사 로그" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}" Width="150"/>
                    <Button Content="조회" Command="{Binding RefreshAuditCommand}" Padding="16,2" Margin="8,0,12,0"/>
                    <TextBlock Text="{Binding AuditMessage}" VerticalAlignment="Center" Foreground="DimGray" Margin="0,0,24,0"/>
                    <Button Content="DB 백업" Command="{Binding BackupCommand}" Padding="14,2" Margin="0,0,8,0" AutomationProperties.AutomationId="BackupButton"/>
                    <TextBlock Text="{Binding BackupMessage}" VerticalAlignment="Center" Foreground="DimGray" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="BackupMessage"/>
                </StackPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          AutomationProperties.AutomationId="AuditGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="140"/>
                        <DataGridTextColumn Header="사용자" Binding="{Binding LoginId}" Width="110"/>
                        <DataGridTextColumn Header="동작" Binding="{Binding Action}" Width="130"/>
                        <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
